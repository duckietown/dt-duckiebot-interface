{
    "type": "object",
    "properties": {
        "sensor_name": {
            "type": "string"
        },
        "sensor_model": {
            "type": "string",
            "enum": [
                "VL53L0X",
                "VL53L1X"
            ]
        },
        "frequency": {
            "type": "number",
            "exclusiveMinimum": 0
        },
        "mode": {
            "type": "string"
        },
        "timing_budget": {
            "description": "How long the chip integrates photons for one measurement, in milliseconds. Omit to use the default that comes with the selected mode. VL53L1X only.",
            "type": [
                "integer",
                "null"
            ],
            "exclusiveMinimum": 0
        },
        "inter_measurement_period": {
            "description": "How often the chip starts a new measurement, in milliseconds. Must be at least as long as the timing budget. Omit to derive it from `frequency`. VL53L1X only.",
            "type": [
                "integer",
                "null"
            ],
            "exclusiveMinimum": 0
        },
        "display_fragment_frequency": {
            "type": "number",
            "minimum": 0
        },
        "connectors": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "bus": {
                        "type": "integer"
                    },
                    "address": {
                        "type": "integer"
                    }
                },
                "required": [
                    "bus",
                    "address"
                ]
            }
        }
    },
    "required": [
        "sensor_name",
        "frequency",
        "mode",
        "display_fragment_frequency",
        "connectors"
    ],
    "oneOf": [
        {
            "properties": {
                "sensor_model": {
                    "const": "VL53L0X"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "BETTER",
                        "GOOD",
                        "BEST",
                        "LONG_RANGE",
                        "HIGH_SPEED"
                    ]
                }
            },
            "required": [
                "mode"
            ]
        },
        {
            "properties": {
                "sensor_model": {
                    "const": "VL53L1X"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "SHORT_RANGE",
                        "LONG_RANGE"
                    ]
                }
            },
            "required": [
                "mode"
            ]
        }
    ]
}
