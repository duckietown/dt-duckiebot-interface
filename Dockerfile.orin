# ─────────────────────────────────────────────────────────────
# Dockerfile.orin  – adds JetPack 5 camera stack for Orin
# ─────────────────────────────────────────────────────────────

ARG BASE_IMG=docker.io/duckietown/dt-duckiebot-interface:ente-arm64v8
FROM ${BASE_IMG}
COPY assets/etc/ld.so.conf.d/nvidia-tegra-egl.conf /etc/ld.so.conf.d/nvidia-tegra-egl.conf
RUN ldconfig

# setup the camera on the Jetson Orin Nano
RUN printf "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal           main restricted universe multiverse\n\
    deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal-updates   main restricted universe multiverse\n\
    deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports focal-security  main restricted universe multiverse\n" \
        > /etc/apt/sources.list \
     && apt-get update

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc | tee /etc/apt/trusted.gpg.d/jetson-ota-public.asc \
    && printf "deb https://repo.download.nvidia.com/jetson/common r35.6 main\ndeb https://repo.download.nvidia.com/jetson/t234 r35.6 main\n" \
         > /etc/apt/sources.list.d/nvidia-l4t.list \
    && apt-get update

RUN set -eux; \
    \
    # 1) Install plain Ubuntu GStreamer bits  
    apt-get update && apt-get install -y --no-install-recommends \
      gstreamer1.0-tools \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad \
      gstreamer1.0-libav \
    ; \
    \
    # 2) Download the needed NVIDIA L4T .debs
    for pkg in \
      nvidia-l4t-core \
      nvidia-l4t-3d-core \
      nvidia-l4t-gstreamer \
      nvidia-l4t-camera \
      nvidia-l4t-multimedia \
      nvidia-l4t-multimedia-utils \
      nvidia-l4t-cuda; do \
      apt-get download "$pkg"; \
    done; \
    \
    # 3) Extract them straight into / (skips their preinst scripts)  
    for deb in ./*.deb; do \
      dpkg-deb -x "$deb" /; \
    done; \
    \
    # 4) Cleanup & reload linker cache  
    rm -fv ./*.deb && rm -rf /var/lib/apt/lists/*; \
    ldconfig
